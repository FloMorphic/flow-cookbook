        "y": 560
      },
      "data": {
        "action": "qdrant.points.scroll",
        "body": {
          "limit": 25,
          "withPayload": true,
          "withVector": false,
          "offset": "{{$.scrolled.result.next_page_offset}}",
          "collection": "chat_kb_demo"
        },
        "form": {
          "schema": {
            "description": "Page through points by filter, without a query vector.",
            "properties": {
              "filter": {
                "title": "Filter (JSON object, optional)",
                "type": "string"
              },
              "limit": {
                "default": 50,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "offset": {
                "title": "Offset (optional)",
                "type": "string"
              },
              "withPayload": {
                "default": true,
                "title": "Include payload",
                "type": "boolean"
              },
              "withVector": {
                "default": false,
                "title": "Include vector",
                "type": "boolean"
              },
              "collection": {
                "title": "Collection",
                "type": "string"
              }
            },
            "required": [
              "collection"
            ],
            "title": "Scroll points",
            "type": "object"
          },
          "ui": {
            "elements": [
              {
                "scope": "#/properties/collection",
                "type": "Control",
                "x-inflow-notif": {
                  "severity": "help",
                  "message": "Name of the Qdrant collection to act on."
                },
                "x-inflow-ui": {
                  "button": {
                    "icon": "↻",
                    "label": "List",
                    "position": "append"
                  },
                  "action": {
                    "name": "pluginFn",
                    "body": {
                      "form": "qdrant.points.scroll",
                      "targetField": "collection"
                    },
                    "fn": "qdrant.meta.collections"
                  }
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/limit"
              },
              {
                "options": {
                  "multi": true
                },
                "scope": "#/properties/filter",
                "type": "Control",
                "x-inflow-notif": {
                  "message": "e.g. {\"must\":[{\"key\":\"tag\",\"match\":{\"value\":\"a\"}}]}",
                  "severity": "help"
                }
              },
              {
                "options": {
                  "multi": true
