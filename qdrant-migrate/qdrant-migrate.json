        "body": {
          "wait": true,
          "collection": "selected_docs",
          "tags": [
            {
              "key": "component",
              "value": "{{$this.payload.component}}"
            },
            {
              "value": "{{$this.payload.component}}",
              "key": "docs"
            }
          ],
          "text": "{{$this.payload.text}}"
        },
        "form": {
          "schema": {
            "description": "Insert one point from a text (embedded with the configured provider) plus payload tags, or paste a Points JSON array below to write a batch. Tag values accept {{$.path}} tokens resolved from the flow.",
            "properties": {
              "points": {
                "title": "Points (JSON array)",
                "type": "string"
              },
              "tags": {
                "items": {
                  "required": [
                    "key"
                  ],
                  "type": "object",
                  "properties": {
                    "key": {
                      "title": "Key",
                      "type": "string"
                    },
                    "value": {
                      "title": "Value",
                      "type": "string"
                    }
                  }
                },
                "title": "Payload tags (key/value)",
                "type": "array"
              },
              "text": {
                "type": "string",
                "title": "Text to embed"
              },
              "vector": {
                "title": "Vector (JSON array, optional)",
                "type": "string"
              },
              "wait": {
                "default": true,
                "title": "Wait for completion",
                "type": "boolean"
              },
              "collection": {
                "title": "Collection",
                "type": "string"
              },
              "id": {
                "title": "Point ID (optional)",
                "type": "string"
              }
            },
            "required": [
              "collection"
