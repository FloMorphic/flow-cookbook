{
  "flomorphic": {
    "kind": "workflow",
    "version": 1,
    "exportedAt": "2026-08-29T00:39:26.405Z"
  },
  "title": "Retriever_with_Qdrant",
  "plugins": [
    {
      "name": "Qdrant",
      "actions": [
        "qdrant.collection.create",
        "qdrant.points.scroll",
        "qdrant.points.upsert"
      ]
    }
  ],
  "nodes": [
    {
      "ref": "start",
      "kind": "startNode",
      "title": "Start",
      "position": {
        "x": 120,
        "y": 151
      }
    },
    {
      "ref": "create-collection",
      "kind": "plugin",
      "title": "Create collection",
      "key": "new_coll",
      "position": {
        "x": 484,
        "y": 139
      },
      "data": {
        "action": "qdrant.collection.create",
        "icon": "mdi-database-plus",
        "body": {
          "distance": "Cosine",
          "onDiskPayload": true,
          "collection": "selected_docs",
          "size": 3072
        }
      }
    },
    {
      "ref": "upsert-points",
      "kind": "plugin",
      "title": "Upsert points",
      "key": "transfer",
      "scope": "$.source_stage.result.points[*]",
      "position": {
        "x": 1212,
        "y": 139
      },
      "data": {
        "icon": "mdi-database-import",
        "action": "qdrant.points.upsert",
        "body": {
          "wait": true,
          "collection": "selected_docs",
          "tags": [
            {
              "key": "component",
              "value": "{{$this.payload.component}}"
            },
            {
              "value": "{{$this.payload.component}}",
              "key": "docs"
            }
          ],
          "text": "{{$this.payload.text}}"
        }
      }
    },
    {
      "ref": "scroll-source-collection",
      "kind": "plugin",
      "title": "Scroll Source Collection",
      "key": "source_stage",
      "position": {
        "x": 848,
        "y": 139
      },
      "data": {
        "action": "qdrant.points.scroll",
        "body": {
          "limit": 40,
          "withPayload": true,
          "withVector": false,
          "collection": "chat_kb_demo",
          "offset": "{{$.source_stage.result.next_page_offset}}"
        },
        "icon": "mdi-format-list-bulleted"
      }
    },
    {
      "ref": "rule",
      "kind": "rule",
      "title": "Rule",
      "scope": "$.source_stage",
      "position": {
        "x": 1940,
        "y": 120
      },
      "data": {
        "handlers": [
          {
            "title": "all pages passed",
            "color": "#8b2fe0",
            "id": "h-1787940323453",
            "name": "done",
            "tags": [
              "done"
            ]
          },
          {
            "name": "continue",
            "tags": [
              "continue"
            ],
            "title": "continue to next page",
            "color": "#16a34a",
            "id": "h-1787940342404"
          }
        ],
        "logic_rule": "let goto = \"done\"\nlet state = _get(\"$.migrate_state\")||{}\nif (input.result?.next_page_offset){\n  goto = \"continue\"\n}\n\ngoto"
      }
    },
    {
      "ref": "page-cursor",
      "kind": "js",
      "title": "Page Cursor",
      "scope": "$.migrate_state",
      "position": {
        "x": 1576,
        "y": 151
      },
      "data": {
        "logic_rule": "let stage = _get(\"$.source_stage.result\")\nif (!input.counter){\n  input={counter:0}\n}\ninput.counter +=  stage.points?.length \ninput"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "create-collection"
    },
    {
      "from": "create-collection",
      "to": "scroll-source-collection"
    },
    {
      "from": "page-cursor",
      "to": "rule"
    },
    {
      "from": "rule",
      "to": "scroll-source-collection",
      "port": "continue"
    },
    {
      "from": "scroll-source-collection",
      "to": "upsert-points"
    },
    {
      "from": "upsert-points",
      "to": "page-cursor"
    }
  ]
}
